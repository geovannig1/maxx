# Maxx environment template, generated from src/config/env.ts by `npm run env:docs`.
# `npm run setup` writes .env.local for you; this file documents every variable.
# Never commit real values. Reference: docs/configuration.md

# ── Database (Supabase) ───────────────────────────────────────────────────────────────────────
# Your Supabase project URL. The browser uses it for sign-in; the server for every database read.
#   required: yes
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# Supabase anon (publishable) key. Browser-safe: the shipped schema grants the anon role nothing, so a leaked anon key reads no data.
#   required: yes
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key with full database access, used by API routes after the owner check and by cron and webhook handlers. It is the whole authorization boundary: keep it off machines that do not need it.
#   required: yes; secret
SUPABASE_SERVICE_ROLE_KEY=

# ── Owner ─────────────────────────────────────────────────────────────────────────────────────
# The one Supabase Auth user allowed in. Unset denies everyone, in development too. Disable public sign-ups in Supabase as well (`npm run doctor` checks it).
#   required: yes
OWNER_EMAIL=owner@example.com
# Optional Supabase user id of the owner. When set, production also requires the signed-in user to have this id, so a second account holding the owner address is refused. `npm run setup` records it when it creates the owner.
#   required: no
# OWNER_USER_ID=

# ── Scheduled jobs ────────────────────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* and /api/sync/midday, compared in constant time. Shorter than 32 characters is treated as unset (the endpoints answer 503). Vercel sends it automatically when it is set in the project.
#   required: in production; secret
CRON_SECRET=

# ── Meta ──────────────────────────────────────────────────────────────────────────────────────
# Meta System User token with ads_read (ads_management only if you enable live writes). Sent in the Authorization header, never in a URL.
#   required: before the dashboard shows data; secret
META_ACCESS_TOKEN=
# The one Meta ad account this install reads.
#   required: before the dashboard shows data
META_AD_ACCOUNT_ID=act_1234567890
# Secret of the Meta app that minted the token. With META_APPSECRET_PROOF_ENABLED=true every Graph call carries appsecret_proof, so a stolen token is useless without it (turn on "Require App Secret" in the Meta app too).
#   required: when META_APPSECRET_PROOF_ENABLED=true; secret
META_APP_SECRET=
# Send appsecret_proof on every Graph call. Keep true.
#   required: no; default false
# META_APPSECRET_PROOF_ENABLED=true
# Emergency pin of the Graph API version without a deploy. Empty uses the version pinned in src/lib/platforms/meta/api-version.ts.
#   required: no
# META_API_VERSION=
# Countries the competitor Ad Library search covers (ad_reached_countries), as comma-separated ISO 3166-1 alpha-2 codes. Unset uses the ad account's business country as Meta reports it, or US when Meta reports none. An invalid list stops the search rather than using another country.
#   required: no
# META_AD_LIBRARY_COUNTRIES=DE,AT
# Pixel (dataset) id for Conversions API sends and tracking-health checks.
#   required: no
# META_PIXEL_ID=
# Optional dataset-scoped Conversions API token from Events Manager; preferred over reusing META_ACCESS_TOKEN.
#   required: no; secret
# META_CAPI_ACCESS_TOKEN=
# Events Manager test code; with a send mode of `test`, conversions go to the Test Events tab only.
#   required: no
# META_TEST_EVENT_CODE=
# Meta pixel event that marks an outcome (Results, actions and tracking health count it), for example Purchase or Lead. Public so the browser counts the same event as the server.
#   required: no; default AppointmentConfirmed
# NEXT_PUBLIC_META_OUTCOME_EVENT=
# Numeric id of a Meta custom conversion that represents an outcome (counted in addition to the named outcome event). Public so the browser counts the same actions as the server.
#   required: no
# NEXT_PUBLIC_META_OUTCOME_CONVERSION_ID=
# Deprecated server-only name of NEXT_PUBLIC_META_OUTCOME_CONVERSION_ID, still accepted; the browser never sees it.
#   required: no
# META_APPOINTMENT_CONVERSION_ID=
# Exactly `true` enables the executor that can change the ad account. Each write still needs an owner approval in the app. Leave off unless you need it.
#   required: no; default false
# WRITE_MODE_ENABLED=
# Largest daily-budget step, in percent of the current budget, that one change you propose may make without an explicit override confirmation. The account-total ceiling (DAILY_BUDGET_CEILING) still applies above it.
#   required: no; default 50
# MAX_BUDGET_CHANGE_PERCENT=
# Minutes after which a change whose run never finished counts as stuck, so you can recover it on Changes ("Recover stuck change"). Keep it above your longest run; on Vercel a run stops after 300 seconds.
#   required: no; default 15
# CHANGE_RECOVERY_STALE_MINUTES=

# ── Business profile ──────────────────────────────────────────────────────────────────────────
# Name shown in the app chrome.
#   required: no
# NEXT_PUBLIC_BUSINESS_NAME=Example Studio
# IANA timezone of the ad account. Every business date, reporting window and contract uses it. It must equal the ad account's timezone_name: a mismatch is refused, never silently mixed.
#   required: no; default America/New_York
# NEXT_PUBLIC_ACCOUNT_TIMEZONE=
# ISO 4217 currency of the ad account. Must equal the ad account's currency. Totals across currencies are refused, never summed.
#   required: no; default USD
# NEXT_PUBLIC_ACCOUNT_CURRENCY=
# BCP 47 locale for numbers, money and dates on owner screens (e.g. de-DE). Formatting only: it never changes the currency or the timezone.
#   required: no; default en-US
# NEXT_PUBLIC_ACCOUNT_LOCALE=de-DE
# What your business calls its outcomes on screen, as singular/plural (booking/bookings, order/orders, lead/leads). Wording only: it never changes what is counted. Meta-reported events keep Meta's own names.
#   required: no; default outcome/outcomes
# NEXT_PUBLIC_OUTCOME_NOUN=booking/bookings
# Your hourly rate in the account currency; only the competitor comparison panel reads it.
#   required: no; default 95
# NEXT_PUBLIC_BUSINESS_HOURLY_RATE=
# Deprecated name of NEXT_PUBLIC_BUSINESS_HOURLY_RATE, still accepted for one release.
#   required: no
# NEXT_PUBLIC_BUSINESS_HOURLY_RATE_USD=
# Partial JSON override of src/config/business-profile.ts (description, website, booking page, city, differentiators, pricing, claims requiring verification). Validated at startup; invalid JSON fails loudly.
#   required: no
# BUSINESS_PROFILE_JSON=
# Owner-approved account-total daily budget ceiling, in the account currency. Recommendations never exceed it.
#   required: no; default 100
# DAILY_BUDGET_CEILING=
# Deprecated name of DAILY_BUDGET_CEILING, still accepted for one release.
#   required: no
# DAILY_BUDGET_CEILING_USD=
# Spend, in the account currency, below which an ad, ad set or campaign is too early to judge. Every other spend floor (dormancy, alerts, target-range minimum spend, trend and pattern thresholds) is a fixed multiple of it. The default suits currencies with USD-sized units; set a larger amount for currencies with small units, e.g. 3000 for JPY.
#   required: no; default 20
# NEXT_PUBLIC_MIN_SPEND_TO_JUDGE=

# ── Outcome sources and conversions ───────────────────────────────────────────────────────────
# Acuity Scheduling user id for the optional Acuity example adapter. Needs ACUITY_API_KEY.
#   required: when ACUITY_API_KEY is set
ACUITY_USER_ID=
# Acuity API key; also the HMAC key Acuity signs its webhooks with.
#   required: when ACUITY_USER_ID is set; secret
ACUITY_API_KEY=
# Optional extra `?secret=` the Acuity webhook URL must carry.
#   required: no; secret
# ACUITY_WEBHOOK_SECRET=
# Conversions API sends for Acuity outcomes: off, test (Test Events only) or live.
#   required: no; default off
# ACUITY_CAPI_SEND=
# First date scripts/backfill-acuity.ts pulls.
#   required: no
# ACUITY_BACKFILL_START=
# Country calling code added to customer phone numbers written without one (44 for the United Kingdom, 49 for Germany, 1 for the United States and Canada) before they are hashed for the Conversions API; a national trunk 0 is removed first. Unset adds no code, so national numbers cannot match. Numbers written with + or 00 keep their own code. Generic (webhook) outcomes use the ad account country (ad_accounts.country) instead when it is set.
#   required: no
# CONVERSIONS_PHONE_COUNTRY_CODE=44
# Largest value of one outcome, in major units of the account currency, accepted from the outcome webhook or a CSV import. A larger value is refused with a 4xx and never sent to the Conversions API.
#   required: no; default 1000000000
# OUTCOME_MONEY_CEILING=
# Conversions API sends for generic (webhook) outcomes: off, test or true. Separate from the reference adapter send flag; CSV outcomes are never sent.
#   required: no; default off
# OUTCOME_CONVERSIONS_SEND=

# ── Paid-touch capture ────────────────────────────────────────────────────────────────────────
# Signs paid-touch tokens. Setup generates it; the endpoint stays inert until the other three paid-touch values are set too.
#   required: when paid-touch capture is configured; secret
PAID_TOUCH_TOKEN_SECRET=
# Rotation grace: the PAID_TOUCH_TOKEN_SECRET you just replaced. Tokens signed with it still verify (nothing new is signed with it) until PAID_TOUCH_TOKEN_PREVIOUS_SECRET_UNTIL, so visitors captured before the switch can still be linked. Remove both once the window is over.
#   required: no; secret
# PAID_TOUCH_TOKEN_PREVIOUS_SECRET=
# End of the rotation grace window for PAID_TOUCH_TOKEN_PREVIOUS_SECRET. At most 7 days ahead: a later or unreadable value turns the window off (the old secret verifies nothing).
#   required: no
# PAID_TOUCH_TOKEN_PREVIOUS_SECRET_UNTIL=2026-11-17T18:00:00Z
# Exact https origins of your website allowed to call /api/attribution/paid-touch (a browser guard, not authentication).
#   required: when paid-touch capture is configured
PAID_TOUCH_ALLOWED_ORIGINS=https://www.example.com
# Landing-page hosts whose ad clicks are captured.
#   required: when paid-touch capture is configured
PAID_TOUCH_ALLOWED_LANDING_HOSTS=www.example.com
# Id of the hidden Acuity intake field that carries the paid-touch token.
#   required: when paid-touch capture is configured
ACUITY_PAID_TOUCH_FIELD_ID=
# Site-wide ceiling on accepted paid-touch captures per hour, whatever client address a request claims.
#   required: no; default 2000
# PAID_TOUCH_GLOBAL_CAPTURES_PER_HOUR=
# Site-wide ceiling on accepted paid-touch delivery acknowledgements per hour.
#   required: no; default 4000
# PAID_TOUCH_GLOBAL_ACKS_PER_HOUR=
# Site-wide ceiling per hour on captures naming an ad not yet synced (a new launch or a forged id); they are kept, not refused.
#   required: no; default 200
# PAID_TOUCH_UNKNOWN_AD_CAPTURES_PER_HOUR=
# Days after which the daily sync deletes paid-touch rows that never became evidence (rejected captures, unlinked touches, expired unused tokens). At least 30.
#   required: no; default 180
# PAID_TOUCH_RETENTION_DAYS=
# How many reverse proxies append to X-Forwarded-For in front of the app (Vercel: 1). The rate limit keys on the address that many hops from the end.
#   required: no; default 1
# PAID_TOUCH_TRUSTED_PROXY_HOPS=

# ── Google Analytics 4 ────────────────────────────────────────────────────────────────────────
# GA4 property id for web telemetry. Optional; needs GA4_SERVICE_ACCOUNT_JSON.
#   required: when GA4_SERVICE_ACCOUNT_JSON is set
GA4_PROPERTY_ID=
# The full service-account JSON key on one line; the account needs Viewer on the property.
#   required: when GA4_PROPERTY_ID is set; secret
GA4_SERVICE_ACCOUNT_JSON=
# GA4 event name that marks an outcome on your website; the website report counts it as Confirmation events.
#   required: no; default appointment_confirmed
# GA4_BOOKING_EVENT=
# GA4 events counted as Intent events on the website report (a visitor starting to buy or book), comma-separated.
#   required: no; default begin_checkout
# GA4_INTENT_EVENTS=
# GA4 events counted as Lead events on the website report (an enquiry or form submission), comma-separated.
#   required: no; default generate_lead
# GA4_LEAD_EVENTS=

# ── AI ────────────────────────────────────────────────────────────────────────────────────────
# AI provider: anthropic, bedrock, vertex, foundry, openai-compatible or none. Unset means anthropic when a Claude key is present, else off. Every report works with AI off.
#   required: no
# AI_PROVIDER=
# Model id. Defaults to claude-opus-5-5 (Bedrock: anthropic.claude-opus-5-5); required for openai-compatible.
#   required: when AI_PROVIDER=openai-compatible
AI_MODEL=
# Effort for chat: low, medium, high, xhigh, max, or none for models without effort. Batch features use low.
#   required: no; default medium
# AI_EFFORT=
# Refusal fallback: default (Claude API server-side), off, or 1-3 comma-separated model ids.
#   required: no
# AI_FALLBACKS=
# Claude API key (AI_PROVIDER=anthropic, or unset).
#   required: when AI_PROVIDER=anthropic and ANTHROPIC_AUTH_TOKEN is unset; secret
ANTHROPIC_API_KEY=
# Claude API bearer token, an alternative to ANTHROPIC_API_KEY.
#   required: no; secret
# ANTHROPIC_AUTH_TOKEN=
# AWS region for AI_PROVIDER=bedrock (or AWS_DEFAULT_REGION).
#   required: when AI_PROVIDER=bedrock and AWS_DEFAULT_REGION is unset
AWS_REGION=
# Fallback AWS region for Bedrock.
#   required: no
# AWS_DEFAULT_REGION=
# Vertex AI region for AI_PROVIDER=vertex.
#   required: no; default global
# CLOUD_ML_REGION=
# Google Cloud project for Vertex AI.
#   required: no
# ANTHROPIC_VERTEX_PROJECT_ID=
# Microsoft Foundry resource name (or ANTHROPIC_FOUNDRY_BASE_URL).
#   required: when AI_PROVIDER=foundry and ANTHROPIC_FOUNDRY_BASE_URL is unset
ANTHROPIC_FOUNDRY_RESOURCE=
# Microsoft Foundry endpoint URL.
#   required: no
# ANTHROPIC_FOUNDRY_BASE_URL=
# Microsoft Foundry API key.
#   required: when AI_PROVIDER=foundry; secret
ANTHROPIC_FOUNDRY_API_KEY=
# Base URL of an OpenAI-compatible server, e.g. http://localhost:11434/v1.
#   required: when AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_BASE_URL=
# API key for the OpenAI-compatible server, if it needs one.
#   required: no; secret
# OPENAI_COMPATIBLE_API_KEY=
# max_tokens or max_completion_tokens, whichever the server accepts.
#   required: no; default max_tokens
# OPENAI_COMPATIBLE_MAX_TOKENS_FIELD=
# Exactly `true` turns on owner chat (it also needs a configured AI provider).
#   required: no; default false
# MAXX_CHAT_ENABLED=
# Optional Creatify key for video generation; blocked while AI is off.
#   required: no; secret
# CREATIFY_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────────────────────
# Daily digest delivery: gmail_smtp or resend. Unset skips the digest.
#   required: no
# DAILY_DIGEST_EMAIL_PROVIDER=
# Weekly executive email delivery: gmail_smtp or resend (defaults to the daily provider).
#   required: no
# WEEKLY_EXECUTIVE_EMAIL_PROVIDER=
# From address for both emails.
#   required: no
# DAILY_DIGEST_FROM_EMAIL=
# Gmail account that sends through SMTP.
#   required: when an email provider is gmail_smtp; secret
GMAIL_SMTP_USER=
# A 16-character Gmail App Password (spaces allowed).
#   required: when an email provider is gmail_smtp; secret
GMAIL_SMTP_APP_PASSWORD=
# Resend API key.
#   required: when an email provider is resend; secret
RESEND_API_KEY=
# Exactly `true` sends the daily executive email from the daily cron.
#   required: no; default false
# MAXX_DAILY_EXECUTIVE_EMAIL_ENABLED=
# Exactly `true` sends the weekly executive email.
#   required: no; default false
# MAXX_WEEKLY_EXECUTIVE_EMAIL_ENABLED=

# ── Monitoring ────────────────────────────────────────────────────────────────────────────────
# Server-side Sentry DSN; Sentry is off when unset.
#   required: no
# SENTRY_DSN=
# Browser Sentry DSN. Set at build time or its origin is left out of the CSP connect-src.
#   required: no
# NEXT_PUBLIC_SENTRY_DSN=
# Build-time token that uploads source maps to Sentry (then deletes them from the build).
#   required: no; secret
# SENTRY_AUTH_TOKEN=
# Sentry organization slug for the source-map upload (read by the Sentry build plugin).
#   required: no
# SENTRY_ORG=
# Sentry project slug for the source-map upload (read by the Sentry build plugin).
#   required: no
# SENTRY_PROJECT=

# ── Feature switches ──────────────────────────────────────────────────────────────────────────
# Exactly `true` enables the pragmatic media-buyer recommendation lane.
#   required: no; default false
# ENABLE_MEDIA_BUYER_RECOMMENDATIONS=
# `off` suppresses the extra live Graph reads behind cockpit trend claims, without a deploy.
#   required: no
# MAXX_COCKPIT_TRENDS=
# Exactly `true` serves prepared (snapshot) reporting responses.
#   required: no; default false
# REPORTING_PREPARED_ENABLED=

# ── Set by the host ───────────────────────────────────────────────────────────────────────────
# The public URL the browser uses for Maxx, e.g. https://maxx.example.com. Sign-in redirects and the same-origin check on every change use it: behind `next start` (and most reverse proxies) the server only sees localhost. Required in production off Vercel; on Vercel the deployment hosts are used when it is unset.
#   required: in production off Vercel
APP_URL=https://maxx.example.com

# ── Operator tooling ──────────────────────────────────────────────────────────────────────────
# Postgres connection string that `npm run setup` passes to `supabase db push --db-url` to apply the schema, and that `npm run doctor` uses to check every migration file was applied. Read only by those two scripts; never written to .env.local.
#   required: no; secret
# SUPABASE_DB_URL=
# Set to 1 only by `npm run demo`: sample data, no accounts. Refused in production (the server will not start).
#   required: no
# MAXX_DEMO=
# Env file that setup and doctor read and write (default .env.local).
#   required: no; default .env.local
# MAXX_ENV_FILE=
# Question file for `npm run eval:golden`.
#   required: no
# MAXX_EVAL_QUESTIONS_FILE=
