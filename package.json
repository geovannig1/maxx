{
  "name": "maxx",
  "version": "1.0.0",
  "private": true,
  "description": "The AI ad agency that outworks yours: builds Meta campaigns from a one-line brief, writes and scores the ads, audits your account daily and shows what to scale, proven against your real sales.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/geovannig1/maxx-ai-media-buyer.git"
  },
  "homepage": "https://github.com/geovannig1/maxx-ai-media-buyer#readme",
  "bugs": {
    "url": "https://github.com/geovannig1/maxx-ai-media-buyer/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup": "tsx --tsconfig tsconfig.scripts.json scripts/setup.ts",
    "doctor": "tsx --tsconfig tsconfig.scripts.json scripts/doctor.ts",
    "demo": "tsx --tsconfig tsconfig.scripts.json scripts/demo/start.ts",
    "demo:check": "tsx --tsconfig tsconfig.scripts.json scripts/demo/check.ts",
    "env:docs": "tsx --tsconfig tsconfig.scripts.json scripts/generate-env-docs.ts",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "mcp:dev": "tsx --tsconfig tsconfig.mcp.json src/mcp/server.ts",
    "mcp:build": "tsc --project tsconfig.mcp.json",
    "sync:manual": "tsx --tsconfig tsconfig.scripts.json scripts/manual-sync.ts",
    "eval:golden": "tsx --tsconfig tsconfig.scripts.json scripts/eval-maxx.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:integration": "node tests/db/integration/supabase-integration.mjs && tsx --tsconfig tsconfig.scripts.json tests/db/integration/engine-pipeline.ts && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "verify:replay": "scripts/verify-replay.sh",
    "typecheck": "tsc --noEmit",
    "gate": "scripts/gate-local.sh static",
    "gate:full": "scripts/gate-local.sh full",
    "release:check": "bash scripts/assert-no-meta-writes.sh && npm run lint && npm run typecheck && npm run mcp:build && npm test && npm run test:db && npm run build",
    "mutate": "node scripts/mutate.mjs",
    "mutate:check": "node scripts/mutate.mjs --self-test",
    "preview:sample": "node tests/reporting-browser/server.mjs --preview",
    "preview:sample:check": "node tests/reporting-browser/interactive-preview-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.0",
    "@anthropic-ai/foundry-sdk": "1.1.0",
    "@anthropic-ai/sdk": "1.3.0",
    "@anthropic-ai/vertex-sdk": "1.1.0",
    "@base-ui/react": "^1.9.0",
    "@google-analytics/data": "^7.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/mocker": "^5.0.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "rimraf": "^6.1.3",
    "proxy-addr": "^2.0.8",
    "fast-glob": "^3.3.3"
  }
}
